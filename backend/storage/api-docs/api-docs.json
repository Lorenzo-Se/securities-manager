                                            "example": "ok"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2026-08-10T12:00:00+00:00"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
